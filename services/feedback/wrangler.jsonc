{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wizardloop-feedback",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-27",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "observability": { "enabled": false },
  "vars": {
    "MODE": "production",
    "ALLOWED_ORIGINS": "https://wizardloop.com",
    "TURNSTILE_HOSTNAMES": "wizardloop.com",
    "TELEGRAM_CHAT_ID_VERIFIED": "false"
  },
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      // Choose an unused positive namespace integer in your account before approved deployment.
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ]
}

[Unit]
Description=WizardLoop validated local artifact preparation without publishing
Requires=wizardloop-profile.service
After=wizardloop-profile.service network-online.target
Wants=network-online.target
ConditionPathExists=/etc/wizardloop/ENABLE_CONTENT_SYNC

[Service]
Type=oneshot
User=wizardloop-build
Group=wizardloop-content
WorkingDirectory=/opt/wizardloop/repository
ExecStart=/usr/bin/python3 /opt/wizardloop/repository/services/posts-sync/deploy/run_service.py build
TimeoutStartSec=45min
UMask=0027
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadOnlyPaths=/var/lib/wizardloop-content/public
ReadOnlyPaths=/var/lib/wizardloop-content/snapshot.lock
InaccessiblePaths=/var/lib/wizardloop-content/private /etc/wizardloop/secrets
ReadWritePaths=/var/lib/wizardloop-build
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
LockPersonality=yes

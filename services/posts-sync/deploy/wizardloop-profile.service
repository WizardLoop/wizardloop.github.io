[Unit]
Description=WizardLoop private profile sync before artifact preparation
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/wizardloop/ENABLE_CONTENT_SYNC

[Service]
Type=oneshot
User=wizardloop-sync
Group=wizardloop-content
WorkingDirectory=/opt/wizardloop/repository
ExecStart=/usr/bin/python3 /opt/wizardloop/repository/services/posts-sync/deploy/run_service.py profile
LoadCredential=profile-api-id:/etc/wizardloop/secrets/profile-api-id
LoadCredential=profile-api-hash:/etc/wizardloop/secrets/profile-api-hash
LoadCredential=profile-token:/etc/wizardloop/secrets/profile-token
TimeoutStartSec=15min
UMask=0027
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/wizardloop-content
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
LockPersonality=yes

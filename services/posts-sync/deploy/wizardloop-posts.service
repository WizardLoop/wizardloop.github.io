[Unit]
Description=WizardLoop private incremental posts sync
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/wizardloop/ENABLE_CONTENT_SYNC

[Service]
Type=oneshot
User=wizardloop-sync
Group=wizardloop-content
WorkingDirectory=/opt/wizardloop/repository
ExecStart=/usr/bin/python3 /opt/wizardloop/repository/services/posts-sync/deploy/run_service.py posts
LoadCredential=posts-token:/etc/wizardloop/secrets/posts-token
TimeoutStartSec=25min
UMask=0027
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/wizardloop-content
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
LockPersonality=yes

# Public configuration only. Never prefix secrets with PUBLIC_.
# Leave blank until the separate feedback Worker is configured and approved.
PUBLIC_FEEDBACK_API_URL=
PUBLIC_TURNSTILE_SITE_KEY=
# Local development automatically uses a clearly labeled loopback mock.
# Set true only for a non-indexable build used for review.
PUBLIC_PREVIEW=false
# Telegram/Cloudflare credentials belong to their separate services, never here.

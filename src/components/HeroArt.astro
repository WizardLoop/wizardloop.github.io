---
const description =
  'My illustrated infinity wizard conjures a glowing orb inside a magical portal';
---

<div
  class="motion-art"
  data-native-hero
  data-state="poster"
  data-playing="false"
  role="img"
  aria-label={description}
>
  <img
    class="art-poster"
    src="/media/previews/portal-alchemy.webp"
    width="512"
    height="512"
    alt=""
    loading="eager"
    fetchpriority="high"
    decoding="async"
  />
  <video
    class="hero-video"
    data-hero-video
    muted
    loop
    playsinline
    preload="none"
    poster="/media/previews/portal-alchemy.webp"
    width="768"
    height="768"
    aria-hidden="true"
    tabindex="-1"
  ></video>
</div>

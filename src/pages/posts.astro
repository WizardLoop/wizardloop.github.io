---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { site } from '../config/site';
import '../styles/destinations.css';
---

<Base
  title="Posts from the studio"
  description="Read WizardLoop's posts on Telegram. Design, motion, creative experiments and notes from the making, in their original home."
>
  <section class="destination-page destination-posts wrap">
    <header class="destination-heading">
      <p class="eyebrow">POSTS / NOTES FROM THE STUDIO</p>
      <h1>
        Fresh from
        <br />
        <em>the loop.</em>
      </h1>
      <p>
        Thoughts, visual experiments and things in the making. Find the posts on
        my Telegram channel.
      </p>
    </header>
    <section
      class="destination-stage destination-dispatch"
      aria-labelledby="posts-heading"
    >
      <div class="destination-copy">
        <span class="destination-index">A DIRECT LINE TO THE STUDIO</span>
        <h2 id="posts-heading">
          Read it where
          <br />
          it happens.
        </h2>
        <p>
          Open the public feed to explore the original posts and media, or join
          the channel to follow along in Telegram.
        </p>
        <div class="destination-actions">
          <a class="button" href={site.links.channelPreview}>
            Read the posts <Icon name="northeast" size={19} />
          </a>
          <a class="text-link" href={site.links.channel}>
            <Icon name="telegram" size={19} /> Join the channel
          </a>
        </div>
        <p class="destination-address">Opens the public Telegram feed.</p>
      </div>
      <div class="destination-art dispatch-drawing" aria-hidden="true">
        <svg viewBox="0 0 460 400" fill="none" focusable="false">
          <circle class="drawing-violet" cx="235" cy="202" r="127" />
          <path
            class="drawing-stroke drawing-dotted"
            d="M87 258c-60-93 33-181 99-125 57 49-66 64-96 139-19 48 38 96 102 63"
          />
          <path
            class="drawing-shadow"
            d="m124 186 237-91-71 226-67-76-47 35 11-66z"
          />
          <path
            class="drawing-paper drawing-stroke"
            d="m114 175 237-91-71 226-67-76-47 35 11-66z"
          />
          <path
            class="drawing-peach drawing-stroke"
            d="m177 203-11 66 47-35L351 84z"
          />
          <path class="drawing-stroke" d="m213 234 138-150" />
          <path
            class="drawing-yellow drawing-stroke"
            d="m82 73 9 23 24 5-24 7-9 23-8-23-24-7 24-5z"
          />
          <path
            class="drawing-stroke"
            d="m327 317 17 6m-26 11 12 13m-28-7 4 17m64-200 20-2m-17 20 17 6"
          />
          <circle class="drawing-ink" cx="265" cy="52" r="4" />
          <circle class="drawing-ink" cx="385" cy="271" r="4" />
        </svg>
        <span class="destination-handnote">See you in the loop.</span>
      </div>
    </section>
    <div class="destination-after">
      <p>Keep the conversation going.</p>
      <a class="text-link" href={site.links.community}>
        Join the community <Icon name="arrow" size={19} />
      </a>
    </div>
  </section>
</Base>

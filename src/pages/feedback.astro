---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { site } from '../config/site';
import '../styles/destinations.css';
---

<Base
  title="Contact"
  description="Contact me directly on Telegram or by email. Share an idea, ask a question about my work or join the conversation in my community."
>
  <section class="destination-page destination-contact wrap">
    <header class="destination-heading">
      <p class="eyebrow">CONTACT / AN IDEA, A QUESTION, A LITTLE HELLO</p>
      <h1>
        Let's start
        <br />
        <em>a conversation.</em>
      </h1>
      <p>
        Something to make, something to ask, or something to share. I'd like to
        hear it.
      </p>
    </header>
    <section
      class="destination-contact-layout"
      aria-labelledby="contact-heading"
    >
      <div class="destination-contact-intro">
        <span class="destination-index">STRAIGHT TO ME</span>
        <h2 id="contact-heading">
          Pick a place
          <br />
          to say hello.
        </h2>
        <p>
          Message me on Telegram or send an email. Tell me a little about your
          idea, question or feedback, and include any links that help explain
          it.
        </p>
        <div class="destination-contact-drawing" aria-hidden="true">
          <svg viewBox="0 0 320 225" fill="none" focusable="false">
            <path class="drawing-shadow" d="m66 65 186-19 13 132-186 19z" />
            <path
              class="drawing-violet drawing-stroke"
              d="m55 54 186-19 13 132-186 19z"
            />
            <path
              class="drawing-paper drawing-stroke"
              d="m55 54 99 66 87-85z"
            />
            <path class="drawing-stroke" d="m68 186 58-86m128 67-75-72" />
            <path
              class="drawing-yellow drawing-stroke"
              d="m271 54 7 19 20 5-20 6-7 19-7-19-20-6 20-5z"
            />
            <path
              class="drawing-accent-stroke"
              d="M13 111h25m-20 17h22m-13 17h15m148 60 20-4m-57 8 21-2"
            />
            <circle class="drawing-ink" cx="34" cy="68" r="3" />
          </svg>
          <span class="destination-handnote">
            Good things start with hello.
          </span>
        </div>
      </div>
      <div class="destination-contact-links">
        <a class="destination-contact-link" href={site.links.telegram}>
          <span class="destination-contact-icon">
            <Icon name="telegram" size={28} />
          </span>
          <span class="destination-contact-label">
            <strong>Telegram</strong>
            <span>@wizardloop</span>
          </span>
          <Icon name="northeast" class="destination-link-arrow" size={23} />
        </a>
        <a class="destination-contact-link" href={`mailto:${site.email}`}>
          <span class="destination-contact-icon">
            <Icon name="mail" size={28} />
          </span>
          <span class="destination-contact-label">
            <strong>Email</strong>
            <span>{site.email}</span>
          </span>
          <Icon name="northeast" class="destination-link-arrow" size={23} />
        </a>
        <div class="destination-email-copy">
          <button
            class="destination-copy-button"
            type="button"
            data-copy-email={site.email}
            hidden
          >
            Copy email address
          </button>
          <p
            class="destination-copy-status"
            role="status"
            aria-live="polite"
            aria-atomic="true"
            data-copy-status
          ></p>
        </div>
        <p class="destination-contact-help">
          Telegram opens my profile for a direct message. Email opens your mail
          app, or you can copy the address above and write to me yourself.
        </p>
        <p class="destination-contact-note">
          Prefer a shared conversation? Come join the community.
        </p>
        <a class="destination-small-link" href={site.links.community}>
          <Icon name="community" size={21} />
          <span>My community</span>
          <Icon name="northeast" size={19} />
        </a>
        <a class="destination-small-link" href={site.links.github}>
          <Icon name="github" size={21} />
          <span>Find me on GitHub</span>
          <Icon name="northeast" size={19} />
        </a>
        <p class="destination-contact-help">
          Community conversations and public GitHub discussions are visible to
          others.
        </p>
      </div>
    </section>
  </section>
</Base>

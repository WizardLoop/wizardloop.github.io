---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { site } from '../config/site';
import '../styles/destinations.css';
---

<Base
  title="Projects & builds"
  description="Explore my public GitHub repositories. I build software, Telegram bots and open-source experiments, and share the source along the way."
>
  <section class="destination-page destination-projects wrap">
    <header class="destination-heading">
      <p class="eyebrow">PROJECTS / SOFTWARE & OPEN SOURCE</p>
      <h1>
        Curiosity.
        <br />
        <em>With source code.</em>
      </h1>
      <p>
        Code is another creative medium. Find my software, Telegram bots and
        experiments on GitHub.
      </p>
    </header>
    <section
      class="destination-stage destination-repositories"
      aria-labelledby="repositories-heading"
    >
      <div class="destination-copy">
        <span class="destination-index">OPEN THE WORKBENCH</span>
        <h2 id="repositories-heading">
          Follow the idea.
          <br />
          Explore the code.
        </h2>
        <p>
          Browse my public repositories to see what I'm building and explore the
          source, documentation and activity of each project.
        </p>
        <div class="destination-actions">
          <a class="button" href={site.links.repositories}>
            <Icon name="github" size={21} /> View all repositories
            <Icon name="northeast" size={19} />
          </a>
        </div>
        <p class="destination-address">Opens the repository list on GitHub.</p>
      </div>
      <div class="destination-art code-drawing" aria-hidden="true">
        <svg viewBox="0 0 460 400" fill="none" focusable="false">
          <path
            class="drawing-stroke drawing-dotted"
            d="M61 191V87h129m131 223h66V180"
          />
          <circle
            class="drawing-peach drawing-stroke"
            cx="61"
            cy="200"
            r="12"
          />
          <circle
            class="drawing-violet drawing-stroke"
            cx="387"
            cy="169"
            r="12"
          />
          <path class="drawing-shadow" d="M103 123h256v193H103z" />
          <path class="drawing-paper drawing-stroke" d="M91 111h256v193H91z" />
          <path class="drawing-stroke" d="M91 150h256" />
          <circle class="drawing-ink" cx="110" cy="131" r="3" />
          <circle class="drawing-ink" cx="123" cy="131" r="3" />
          <circle class="drawing-ink" cx="136" cy="131" r="3" />
          <path
            class="drawing-accent-stroke drawing-code"
            d="m172 190-35 33 35 33m94-66 35 33-35 33m-34-78-26 91"
          />
          <path
            class="drawing-yellow drawing-stroke"
            d="m238 62 17-34 17 34 37 5-27 25 7 37-34-18-34 18 7-37-27-25z"
          />
          <path
            class="drawing-stroke"
            d="m50 284 17-7m-12 27h18m258-238 15-11m-8 31 18-3"
          />
          <path
            class="drawing-accent-stroke"
            d="M151 344c30 27 99 30 133 2m-13-9 15 8-8 15"
          />
          <circle class="drawing-ink" cx="97" cy="53" r="4" />
          <circle class="drawing-ink" cx="376" cy="352" r="4" />
        </svg>
        <span class="destination-handnote">An idea, made tangible.</span>
      </div>
    </section>
    <div class="destination-after">
      <p>Have a question about something I'm building?</p>
      <a class="text-link" href="/feedback/">
        Get in touch <Icon name="arrow" size={19} />
      </a>
    </div>
  </section>
</Base>

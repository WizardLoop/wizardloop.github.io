---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import MotionArt from '../components/MotionArt.astro';
import projects from '../content/projects.json';
import { site } from '../config/site';
---

<Base
  title="Projects & builds"
  description="Explore WizardLoop's verified open-source projects, including MagicLottie, Shabbat and CreationDate."
>
  <section class="page-intro wrap">
    <p class="eyebrow">CODE IS ANOTHER CREATIVE MEDIUM</p>
    <h1>
      Curiosity.
      <br />
      <span class="outlined-word">With a source code.</span>
    </h1>
    <p>
      Open-source tools, Telegram bots and small software experiments. Built by
      WizardLoop, shared on GitHub.
    </p>
  </section>
  <section class="project-gallery wrap" aria-label="Open-source projects">
    {projects.map((project, i) => (
      <article class={`project-feature ${project.color}-card`}>
        <div class="project-feature-art">
          <MotionArt
            name={project.art}
            alt={`WizardLoop illustration accompanying ${project.name}`}
          />
          <span class="art-source">
            Original WizardLoop illustration.
            <br />
            Not a product screenshot.
          </span>
        </div>
        <div class="project-feature-copy">
          <p class="eyebrow">
            0{i + 1} / {project.category}
          </p>
          <h2>{project.name}</h2>
          <p>{project.description}</p>
          <p class="small-text">{project.role}</p>
          <a class="button" href={project.url}>
            <Icon name="github" />
            View the repository <Icon name="northeast" size={18} />
          </a>
        </div>
      </article>
    ))}
  </section>
  <div class="page-end wrap">
    <a class="text-link" href={site.links.github}>
      Explore all public repositories <Icon name="northeast" />
    </a>
  </div>
</Base>

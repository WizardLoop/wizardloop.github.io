---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import MotionArt from '../components/MotionArt.astro';
import HeroArt from '../components/HeroArt.astro';
import SparkMark from '../components/SparkMark.astro';
import { site } from '../config/site';
---

<Base title="I make things come alive" profile>
  <section class="hero wrap" aria-labelledby="hero-title">
    <div class="hero-topline">
      <p class="eyebrow">
        <span class="ink-dot"></span>INDEPENDENT CREATIVE / WIZARDLOOP
      </p>
      <span class="edition-note">ONE CURIOUS CREATOR. A WORLD OF IDEAS.</span>
    </div>
    <div class="hero-grid">
      <div class="hero-copy">
        <h1 id="hero-title">
          <span>MAKE</span>
          <span class="hero-line">
            IT <SparkMark size={87} class="drawn-star" />
          </span>
          <span class="magic-word">
            MAGIC<span aria-hidden="true">.</span>
          </span>
        </h1>
        <p class="hero-intro">
          <strong>I make things come alive.</strong>
          <br />
          Design, illustration, motion and code.
          <br />
          Made with curiosity. Sprinkled with the unexpected.
        </p>
        <div class="hero-actions">
          <a class="button" href="/work/">
            Explore my work <Icon name="arrow" />
          </a>
          <a
            class="icon-link"
            href={site.links.telegram}
            aria-label="Contact me on Telegram"
            data-tooltip="Say hello on Telegram"
          >
            <Icon name="telegram" size={24} />
          </a>
          <a
            class="icon-link"
            href={site.links.github}
            aria-label="Explore my GitHub profile"
            data-tooltip="Explore GitHub"
          >
            <Icon name="github" size={24} />
          </a>
        </div>
      </div>
      <div class="hero-illustration">
        <div class="comic-label label-top">
          <span>IMAGINATION, ACTIVATED.</span>
          <Icon name="sparkle" size={17} />
        </div>
        <div class="hero-stage">
          <div class="halftone" aria-hidden="true"></div>
          <span class="panel-coordinate" aria-hidden="true">
            A WINDOW INTO MY IMAGINATION
          </span>
          <HeroArt />
          <svg class="comic-rays" viewBox="0 0 500 500" aria-hidden="true">
            <path d="m43 82 28 31M21 119l37 15M444 71l-27 30m41 7-32 13M48 405l28-24m348 34-20-30" />
          </svg>
          <span class="hero-sticker">
            <span>
              100%
              <br />
              WIZARDLOOP
            </span>
          </span>
        </div>
        <div class="stage-footnote">
          <span class="hand-note">
            A little magic.
            <br />A lot of making.
          </span>
          <span class="art-source">
            An animation from my studio
            <br />A little piece of my world
          </span>
        </div>
      </div>
    </div>
    <div class="discipline-line" aria-label="Creative disciplines">
      <span>DESIGN</span>
      <Icon name="sparkle" />
      <span>ILLUSTRATION</span>
      <Icon name="sparkle" />
      <span>MOTION</span>
      <Icon name="sparkle" />
      <span>SOFTWARE</span>
      <Icon name="northeast" />
    </div>
  </section>
  <section class="section wrap" aria-labelledby="explore-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">01 / FOLLOW THE CURIOSITY</p>
        <h2 id="explore-title">
          Different doors.
          <br />
          <span class="outlined-word">One creative world.</span>
        </h2>
      </div>
    </div>
    <div class="home-paths">
      <a class="home-path" href="/work/">
        <span class="home-path-icon">
          <Icon name="sparkle" size={32} />
        </span>
        <span class="eyebrow">THE VISUAL SIDE</span>
        <h3>
          Art, motion
          <br />& imagination.
        </h3>
        <p>Find my portfolio and creative work in the Telegram channel.</p>
        <span class="text-link">
          Find the work <Icon name="northeast" />
        </span>
      </a>
      <a class="home-path" href="/projects/">
        <span class="home-path-icon">
          <Icon name="github" size={32} />
        </span>
        <span class="eyebrow">THE CODE SIDE</span>
        <h3>
          Ideas with
          <br />
          source code.
        </h3>
        <p>Explore my public repositories, tools and experiments on GitHub.</p>
        <span class="text-link">
          Explore the builds <Icon name="northeast" />
        </span>
      </a>
      <a class="home-path" href="/feedback/">
        <span class="home-path-icon">
          <Icon name="telegram" size={32} />
        </span>
        <span class="eyebrow">THE HUMAN SIDE</span>
        <h3>
          It starts with
          <br />a conversation.
        </h3>
        <p>
          A question, a collaboration or a hello. Choose how to get in touch.
        </p>
        <span class="text-link">
          Let's talk <Icon name="northeast" />
        </span>
      </a>
    </div>
  </section>
  <section class="about-teaser section wrap" aria-labelledby="about-title">
    <div class="about-drawing">
      <MotionArt
        name="living-spellbook"
        alt="My illustrated wizard emerges from an open spellbook"
      />
      <span class="sketch-caption">The person behind the pixels ↗</span>
    </div>
    <div class="about-teaser-copy">
      <p class="eyebrow">02 / HELLO, I'M WIZARDLOOP</p>
      <h2 id="about-title">
        Part designer.
        <br />
        Part developer.
        <br />
        <em>Entirely curious.</em>
      </h2>
      <p>
        I'm an independent designer, illustrator, animator and developer. I make
        expressive characters, playful visuals, unexpected loops and software
        that does something useful.
      </p>
      <p>
        Some ideas become a drawing. Others become a Telegram bot or an
        open-source tool. I like the space where they meet.
      </p>
      <a class="text-link" href="/about/">
        A little more about me <Icon name="northeast" />
      </a>
    </div>
  </section>
  <section class="posts-teaser section wrap" aria-labelledby="posts-title">
    <div class="post-comic">
      <span class="comic-label">A NOTE FROM THE STUDIO</span>
      <MotionArt
        name="silver-grimoire"
        alt="A silver infinity emblem with engraved details and glinting highlights"
      />
      <span class="speech-note">
        There's always
        <br />
        another idea.
      </span>
    </div>
    <div>
      <p class="eyebrow">03 / NOTES, LOOPS & LITTLE DISCOVERIES</p>
      <h2 id="posts-title">
        The making.
        <br />
        The in-between.
        <br />
        <span class="outlined-word">The loop.</span>
      </h2>
      <p>
        Animation drops, works in progress and things worth sharing. Find them
        on my Telegram channel, in their original format.
      </p>
      <div class="inline-actions">
        <a class="button" href={site.links.channelPreview}>
          Read on Telegram <Icon name="arrow" />
        </a>
        <a class="text-link" href={site.links.channel}>
          <Icon name="telegram" />
          Join the channel
        </a>
      </div>
    </div>
  </section>
  <section class="contact-cta wrap">
    <SparkMark size={90} class="cta-spark" />
    <p class="eyebrow">GOOD THINGS START WITH A LITTLE CURIOSITY.</p>
    <h2>
      Got a strange idea?
      <br />
      <span>I'm listening.</span>
    </h2>
    <div class="inline-actions">
      <a class="button" href="/feedback/">
        Let's talk <Icon name="arrow" />
      </a>
      <a class="text-link" href={site.links.community}>
        <Icon name="community" />
        Find your people
      </a>
    </div>
    <span class="cta-doodle" aria-hidden="true">
      More magic,
      <br />
      together.
    </span>
  </section>
</Base>

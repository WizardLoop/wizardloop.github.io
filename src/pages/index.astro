---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import MotionArt from '../components/MotionArt.astro';
import HeroArt from '../components/HeroArt.astro';
import { site } from '../config/site';
import projects from '../content/projects.json';
---

<Base title="I make things come alive" profile>
  <section class="hero wrap" aria-labelledby="hero-title">
    <div class="hero-topline">
      <p class="eyebrow">
        <span class="ink-dot"></span>INDEPENDENT CREATIVE / WIZARDLOOP
      </p>
      <span class="edition-note">A SMALL STUDIO. A CURIOUS UNIVERSE.</span>
    </div>
    <div class="hero-grid">
      <div class="hero-copy">
        <h1 id="hero-title">
          <span>MAKE</span>
          <span class="hero-line">
            IT{' '}
            <svg class="drawn-star" viewBox="0 0 100 100" aria-hidden="true">
              <path d="m50 2 8 31 28-18-18 28 30 7-30 8 18 28-28-18-8 30-8-30-28 18 18-28-30-8 30-7-18-28 28 18Z" />
            </svg>
          </span>
          <span class="magic-word">
            MAGIC<span aria-hidden="true">.</span>
          </span>
        </h1>
        <p class="hero-intro">
          <strong>I make things come alive.</strong>
          <br />
          Design, illustration, motion and code.
          <br />
          Made with curiosity. Sprinkled with the unexpected.
        </p>
        <div class="hero-actions">
          <a class="button" href="/work/">
            Explore my work <Icon name="arrow" />
          </a>
          <a
            class="icon-link"
            href={site.links.telegram}
            aria-label="Contact WizardLoop on Telegram"
            data-tooltip="Say hello on Telegram"
          >
            <Icon name="telegram" size={24} />
          </a>
          <a
            class="icon-link"
            href={site.links.github}
            aria-label="WizardLoop on GitHub"
            data-tooltip="Explore GitHub"
          >
            <Icon name="github" size={24} />
          </a>
        </div>
      </div>
      <div class="hero-illustration">
        <div class="comic-label label-top">
          <span>IMAGINATION, ACTIVATED.</span>
          <Icon name="sparkle" size={17} />
        </div>
        <div class="hero-stage">
          <div class="halftone" aria-hidden="true"></div>
          <span class="panel-coordinate" aria-hidden="true">
            FIG. 001 / PORTAL ALCHEMY
          </span>
          <HeroArt />
          <svg class="comic-rays" viewBox="0 0 500 500" aria-hidden="true">
            <path d="m43 82 28 31M21 119l37 15M444 71l-27 30m41 7-32 13M48 405l28-24m348 34-20-30" />
          </svg>
          <span class="hero-sticker">
            <span>
              100%
              <br />
              WIZARDLOOP
            </span>
          </span>
        </div>
        <div class="stage-footnote">
          <span class="hand-note">
            A little magic.
            <br />A lot of making.
          </span>
          <span class="art-source">
            Original WizardLoop animation
            <br />
            Infinity Atelier collection
          </span>
        </div>
      </div>
    </div>
    <div class="discipline-line" aria-label="Creative disciplines">
      <span>DESIGN</span>
      <Icon name="sparkle" />
      <span>ILLUSTRATION</span>
      <Icon name="sparkle" />
      <span>MOTION</span>
      <Icon name="sparkle" />
      <span>SOFTWARE</span>
      <Icon name="northeast" />
    </div>
  </section>
  <section class="work-teaser section wrap" aria-labelledby="work-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">01 / STRAIGHT FROM MY IMAGINATION</p>
        <h2 id="work-title">
          Small worlds.
          <br />
          <span class="outlined-word">Big personality.</span>
        </h2>
      </div>
      <a class="text-link" href="/work/">
        See the collection <Icon name="northeast" />
      </a>
    </div>
    <div class="art-grid">
      <a class="art-card violet-card" href="/work/#infinity-atelier">
        <div class="card-art">
          <span class="card-tag">DESIGN + ANIMATION</span>
          <MotionArt
            name="signature-spirit"
            alt="Purple infinity wizard with a curved pointed hat and bright eyes"
          />
          <span class="card-index" aria-hidden="true">
            01
          </span>
        </div>
        <div class="card-caption">
          <div>
            <h3>Infinity Atelier</h3>
            <p>Thirty little moments of wizardry.</p>
          </div>
          <span class="round-arrow">
            <Icon name="northeast" />
          </span>
        </div>
      </a>
      <a class="art-card mint-card" href="/work/#infinity-atelier">
        <div class="card-art">
          <span class="card-tag">ILLUSTRATED LOOPS</span>
          <MotionArt
            name="paints-the-world"
            alt="WizardLoop's wizard paints a ribbon of light in the air"
          />
          <span class="card-index" aria-hidden="true">
            02
          </span>
        </div>
        <div class="card-caption">
          <div>
            <h3>Paints the World</h3>
            <p>A character with a mind of its own.</p>
          </div>
          <span class="round-arrow">
            <Icon name="northeast" />
          </span>
        </div>
      </a>
      <a class="art-card peach-card" href="/projects/">
        <div class="card-art">
          <span class="card-tag">CODE + CURIOSITY</span>
          <MotionArt
            name="arcane-coder"
            alt="WizardLoop's wizard beside a laptop and floating code symbols"
          />
          <span class="card-index" aria-hidden="true">
            03
          </span>
        </div>
        <div class="card-caption">
          <div>
            <h3>A different kind of spell</h3>
            <p>Useful tools. Open source. Real code.</p>
          </div>
          <span class="round-arrow">
            <Icon name="northeast" />
          </span>
        </div>
      </a>
    </div>
  </section>
  <section class="about-teaser section wrap" aria-labelledby="about-title">
    <div class="about-drawing">
      <MotionArt
        name="living-spellbook"
        alt="WizardLoop's wizard emerges from an open illustrated spellbook"
      />
      <span class="sketch-caption">The person behind the pixels ↗</span>
    </div>
    <div class="about-teaser-copy">
      <p class="eyebrow">02 / HELLO, I'M WIZARDLOOP</p>
      <h2 id="about-title">
        Part designer.
        <br />
        Part developer.
        <br />
        <em>Entirely curious.</em>
      </h2>
      <p>
        I'm an independent designer, illustrator, animator and developer. I make
        expressive characters, playful visuals, unexpected loops and software
        that does something useful.
      </p>
      <p>
        Some ideas become a drawing. Others become a Telegram bot or an
        open-source tool. I like the space where they meet.
      </p>
      <a class="text-link" href="/about/">
        A little more about me <Icon name="northeast" />
      </a>
    </div>
  </section>
  <section class="builds-section section wrap" aria-labelledby="builds-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">03 / LESS HOCUS. MORE FOCUS.</p>
        <h2 id="builds-title">
          Things I've <span class="marker-word">built.</span>
        </h2>
      </div>
      <a class="text-link" href="/projects/">
        All builds <Icon name="northeast" />
      </a>
    </div>
    <div class="project-list">
      {projects.map((project, i) => (
        <a class="project-row" href={project.url}>
          <span class="project-number">0{i + 1}</span>
          <div>
            <h3>{project.name}</h3>
            <p>{project.description}</p>
          </div>
          <span class="project-category">{project.category}</span>
          <Icon name="northeast" size={28} />
        </a>
      ))}
    </div>
  </section>
  <section class="posts-teaser section wrap" aria-labelledby="posts-title">
    <div class="post-comic">
      <span class="comic-label">A NOTE FROM THE STUDIO</span>
      <MotionArt
        name="overwhelmed-hat"
        alt="A playful wizard hat floats above a small chat bubble"
      />
      <span class="speech-note">
        There's always
        <br />
        another idea.
      </span>
    </div>
    <div>
      <p class="eyebrow">04 / NOTES, LOOPS & LITTLE DISCOVERIES</p>
      <h2 id="posts-title">
        The making.
        <br />
        The in-between.
        <br />
        <span class="outlined-word">The loop.</span>
      </h2>
      <p>
        Animation drops, works in progress and things worth sharing. Find them
        on my Telegram channel, with original posts close at hand.
      </p>
      <div class="inline-actions">
        <a class="button" href="/posts/">
          Read the posts <Icon name="arrow" />
        </a>
        <a class="text-link" href={site.links.channel}>
          <Icon name="telegram" />
          Join the channel
        </a>
      </div>
    </div>
  </section>
  <section class="contact-cta wrap">
    <div class="cta-spark" aria-hidden="true">
      ✳
    </div>
    <p class="eyebrow">GOOD THINGS START WITH A LITTLE CURIOSITY.</p>
    <h2>
      Got a strange idea?
      <br />
      <span>I'm listening.</span>
    </h2>
    <div class="inline-actions">
      <a class="button" href="/feedback/">
        Let's talk <Icon name="arrow" />
      </a>
      <a class="text-link" href={site.links.community}>
        <Icon name="community" />
        Find your people
      </a>
    </div>
    <span class="cta-doodle" aria-hidden="true">
      More magic,
      <br />
      together.
    </span>
  </section>
</Base>
